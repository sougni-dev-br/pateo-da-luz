# Exemplo de variáveis para o backend. Copie para `backend/.env` e preencha
# com valores locais. NUNCA commitar `.env` com segredos reais — o .gitignore
# bloqueia isso, mas o cuidado é seu.

# Postgres local de desenvolvimento (Prisma). Em produção o Render injeta
# essa variável automaticamente — não colocar aqui a URL de produção.
DATABASE_URL="postgresql://cmv:cmv@localhost:5432/cmv_loja?schema=public"

PORT=3334

# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"

# Token de integração do agente que roda no PDVTOUCH (Agile PDV).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Manter idêntico no config.json do agente (C:\PateoAgent\config.json).
AGILE_INGEST_TOKEN="troque-este-token-para-a-integracao-agile"

# ─── WhatsApp (Baileys embarcado) — resumo diário ────────────────────────────
# O Baileys roda dentro do próprio backend. Sessão persistida na tabela
# WhatsAppAuthState no Postgres. Auto-conecta no boot; se não houver creds
# na tabela, gera QR e expõe em GET /notifications/whatsapp/qr (protegido
# por sessão via menuId=notifications).
#
# Nome lógico da sessão (default "pateo"). Só troca se rodar múltiplas
# sessões no mesmo backend.
WHATSAPP_SESSION_NAME="pateo"

# Fallback opcional. Se a tabela WhatsAppRecipient estiver vazia, o resumo
# é enviado para este número. Em produção, cadastre destinatários pela UI
# (/configuracoes/notificacoes) e deixe este vazio.
WHATSAPP_TO=""

# Token que o cron externo (cron-job.org, Render Cron Job) envia no header
# X-Daily-Summary-Token para disparar POST /notifications/daily-summary/trigger.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DAILY_SUMMARY_TOKEN="troque-este-token-para-disparo-do-resumo-diario"

# Fuso do processo. Datas de competencia usam new Date(ano, mes, dia), que
# resolve a meia-noite no fuso de quem executa. Producao roda em UTC; deixar
# o local diferente faz o mesmo lancamento cair em meses diferentes.
TZ=UTC
