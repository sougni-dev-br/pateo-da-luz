// =====================================================================
// Integrações de Delivery (iFood, 99 Food, Keeta)
// Fase 1: estrutura + credenciais + lojas persistidas. Dados de vendas /
// repasses / taxas ficam GERADOS via mock service enquanto o iFood não
// libera credenciais reais. Na Fase 2 o mock é substituído por chamada
// à Financial API do iFood e os registros passam a ser persistidos.
// =====================================================================

enum DeliveryPlatform {
  IFOOD
  NOVENTA_NOVE
  KEETA
}

model DeliveryStore {
  id         String           @id @default(cuid())
  platform   DeliveryPlatform
  externalId String
  // shopIdRemote é o ID que a plataforma (99/Keeta) atribui à loja no
  // sistema deles depois do bind. iFood: reutiliza externalId (merchantId).
  // 99: externalId = app_shop_id (nosso), shopIdRemote = shop_id (deles),
  // recebido no callback de autorização/pedido. Bigint como string pra
  // não perder precisão em JSON.
  shopIdRemote String?
  nickname   String
  active     Boolean          @default(true)
  // Loja iFood aponta pra uma Company do ERP — usada pra rotear
  // faturamento (RevenueEntry), despesas (Purchase) e recebíveis
  // (Receivable) pro CNPJ correto no DRE. Opcional só pra permitir
  // cadastro incremental; sync que exige companyId só roda quando setado.
  companyId  String?
  company    Company?         @relation(fields: [companyId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  ifoodSales             IfoodSale[]
  ifoodSettlements       IfoodSettlement[]
  ifoodFees              IfoodFee[]
  ifoodSyncLogs          IfoodSyncLog[]
  ifoodMonthlyExpenses   IfoodMonthlyExpense[]

  noventaNoveSales           NoventaNoveSale[]
  noventaNoveSettlements     NoventaNoveSettlement[]
  noventaNoveFees            NoventaNoveFee[]
  noventaNoveSyncLogs        NoventaNoveSyncLog[]
  noventaNoveMonthlyExpenses NoventaNoveMonthlyExpense[]
  noventaNoveAuthToken       NoventaNoveShopAuthToken?
  dishListings               DishListing[]

  @@unique([platform, externalId])
  @@index([platform, active])
  @@index([companyId])
}

