enum IfoodMonthlyExpenseStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model IfoodMonthlyExpense {
  id                 String                    @id @default(cuid())
  deliveryStoreId    String
  deliveryStore      DeliveryStore             @relation(fields: [deliveryStoreId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?                  @relation(fields: [companyId], references: [id])
  competenceYear     Int
  competenceMonth    Int
  dueDate            DateTime

  // Breakdown por tipo — soma bate com totalAmount.
  commissionAmount   Decimal                   @default(0) @db.Decimal(14, 2)
  deliveryFeeAmount  Decimal                   @default(0) @db.Decimal(14, 2)
  marketingAmount    Decimal                   @default(0) @db.Decimal(14, 2)
  maintenanceAmount  Decimal                   @default(0) @db.Decimal(14, 2)
  anticipationAmount Decimal                   @default(0) @db.Decimal(14, 2)
  otherAmount        Decimal                   @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal                   @db.Decimal(14, 2)
  paidAmount         Decimal?                  @db.Decimal(14, 2)

  status             IfoodMonthlyExpenseStatus @default(OPEN)
  paidAt             DateTime?
  paymentMethod      String?
  notes              String?
  // Sync sempre reescreve se autoGenerated=true e status=OPEN. Se operador
  // marcar como PAID ou editar manualmente, sync respeita (não sobrescreve).
  autoGenerated      Boolean                   @default(true)

  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?

  @@unique([deliveryStoreId, competenceYear, competenceMonth], map: "ifme_store_competence_uniq")
