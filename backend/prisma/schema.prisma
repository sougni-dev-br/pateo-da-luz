  @@index([companyId, competenceYear, competenceMonth], map: "ifme_company_competence_idx")
}

// =====================================================================
// 99 Food — espelha o padrão iFood.
// Cadastro do lojista em https://developer-food.99app.com. Credencial
// segue o mesmo shape (clientId + clientSecret + environment). Enquanto
// a plataforma não aprovar o aplicativo do Pateo, o módulo opera com
// mocks (isMock=true nos summaries) e o sync real fica gated.
// =====================================================================

// Credencial global do app cadastrado em developer-food.99app.com.
// Na terminologia da 99: app_id (clientId) + app_secret (clientSecret).
// clientId aqui é o long bigint da 99 armazenado como string.
model NoventaNoveCredential {
  id                String   @id @default(cuid())
  clientId          String
  clientSecret      String
  environment       String   @default("PRODUCTION")
  active            Boolean  @default(true)
  lastTokenAt       DateTime?
  // Percentual de comissão contratual (ex: 18.00 = 18%). A DiDi não expõe
  // a comissão real via callback, então usamos este % pra estimar
  // noventaNoveFeeAmount de cada pedido. Reconciliar depois com invoice
  // mensal se a 99 mandar valor real por outro canal.
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Auth token por loja — a 99 gera um token distinto por (app_id, secret,
// app_shop_id). Cada token tem validade e precisa refresh. Guardamos em
// tabela dedicada 1:1 com DeliveryStore pra não pollur o cadastro da loja
// com detalhes de auth.
model NoventaNoveShopAuthToken {
  deliveryStoreId String        @id
  deliveryStore   DeliveryStore @relation(fields: [deliveryStoreId], references: [id], onDelete: Cascade)
  authToken       String
  expiresAt       DateTime
  refreshedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([expiresAt], map: "nnsat_expires_idx")
}

