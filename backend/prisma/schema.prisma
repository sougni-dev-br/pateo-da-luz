// ─── WhatsApp (Baileys) ───────────────────────────────────────────────────
// Baileys mantém dois tipos de estado que precisam sobreviver a restart do
// backend (senão exige QR novo a cada deploy):
//   1. `creds` — 1 blob JSON. Identidade do dispositivo linkado.
//   2. `keys`  — dezenas de blobs JSON, keyed por (tipo, id). Cifra E2E.
// O adapter de auth em `baileys.service.ts` grava tudo aqui.
//
// `sessionName` = identificador lógico da sessão (ex.: "pateo"). Permite
// eventualmente rodar >1 sessão simultânea sem colisão de chaves.
model WhatsAppAuthState {
  id          String   @id @default(cuid())
  sessionName String
  // "creds" para o blob principal; "keys" para cada key de assinatura.
  category    String
  // Para creds: sempre "main". Para keys: "<type>-<id>" (ex.: "pre-key-42").
  key         String
  // JSON serializado (Buffer é convertido para base64 antes de gravar).
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionName, category, key])
  @@index([sessionName])
}

// Destinatários do resumo diário WhatsApp. Gerenciados via UI em
// /configuracoes/notificacoes. isActive permite pausar sem apagar
// (mantém histórico e ordem original).
model WhatsAppRecipient {
  id        String   @id @default(cuid())
  name      String
  // Só dígitos, incluindo DDI (ex.: "5511961894636"). Validação de formato
  // no backend antes de gravar.
  phone     String
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Registro de envio bem-sucedido do resumo diário. Chave (date, recipientId)
// é única — se o cron chamar /trigger 2x no mesmo dia, o segundo pula os
// destinatários já enviados. Garante zero duplicação mesmo com retry.
model DailySummarySent {
  id            String   @id @default(cuid())
  // YYYY-MM-DD no fuso America/Sao_Paulo (mesma convenção do resumo).
  date          String
  // Ou o id do WhatsAppRecipient ("cmxxx...") ou "env" quando origem é
  // WHATSAPP_TO fallback. Não é FK — recipient pode ser deletado
  // depois e o histórico deve continuar consultável.
  recipientId   String
  recipientName String?
  phone         String
  messageId     String?
  sentAt        DateTime @default(now())

  @@unique([date, recipientId])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────
// Folha de Pagamento — Funcionários (Fase 1)
// Cadastro de funcionários do restaurante. NÃO confundir com User (login do
// sistema). Base para escala mensal, cálculo de VT e folha (fases seguintes).
// Reusa o enum BankAccountType. Padrão de auditoria/soft-delete igual ao
// módulo tax-payments.
// ─────────────────────────────────────────────────────────────────────────

// Usado APENAS para a regra de folga dominical: a CLT art. 386 garante à
// mulher uma folga em domingo a cada 15 dias, contra 7 semanas na regra geral.
// Sem o campo não dá para saber qual limite aplicar — e inferir de nome é chute.
enum EmployeeGender {
  FEMININO
  MASCULINO
  NAO_INFORMADO
}

enum EmployeeModality {
  CLT
  NAO_CLT
}

enum WorkScheduleRegime {
  SEIS_POR_UM
  CINCO_POR_DOIS
}

enum VtType {
  NENHUM
  TRANSPORTE_PUBLICO
  BILHETE_MENSAL
  AUXILIO_COMBUSTIVEL
}

enum VtPeriodicity {
  QUINZENAL
  MENSAL
}

// Sentido do trajeto. O funcionário pode ir de um jeito e voltar de outro —
// ida de ônibus + metrô, volta só de ônibus — e isso muda o valor do dia.
enum VtDirection {
  IDA
  VOLTA
}

// Como a tarifa é cobrada: por embarque (VIAGEM) ou um valor fechado no mês
// (MENSAL, tipo Bilhete Único Mensal, que não depende de dias trabalhados).
enum VtFareBasis {
  VIAGEM
  MENSAL
}

// ─────────────────────────────────────────────────────────────────────────
// Tarifas de transporte — tabela editável, não campos fixos.
//
// Antes eram 3 colunas em PayrollSettings (ônibus, metrô, integrada), o que
// tornava impossível cadastrar EMTU (intermunicipal, Carapicuíba→SP) sem
// mexer no schema. Agora cada tarifa é uma linha, com a própria regra de
// gratuidade: ônibus SPTrans é grátis domingo/feriado, EMTU e metrô não.
// Amarrar a gratuidade à TARIFA (e não ao código) é o que faz o cálculo
// parar de zerar indevidamente a perna de EMTU de quem viaja no domingo.
// ─────────────────────────────────────────────────────────────────────────
model VtFare {
  id            String      @id @default(cuid())
  name          String      @unique
  amount        Decimal     @db.Decimal(8, 2)
  basis         VtFareBasis @default(VIAGEM)
  /// Quanto esta tarifa custa nos dias de Domingão Tarifa Zero (domingos + 01/01,
  /// 25/01 e 25/12). NULL = não muda nada nesses dias.
  ///
  /// É um VALOR e não um "grátis sim/não" porque a integração ônibus+metrô não
  /// zera no domingo: a SPTrans não dá desconto de integração quando o ônibus é
  /// gratuito, então quem integra paga a tarifa CHEIA do metrô (R$ 5,40) em vez
  /// dos R$ 9,38 da integração. Um booleano não sabe dizer isso.
  sundayAmount  Decimal?    @db.Decimal(8, 2)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  notes         String?
  legs          EmployeeVtLeg[]
  monthlyEmployees Employee[] @relation("EmployeeMonthlyFare")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────
// Desconto de VT por falta.
//
// O VT é pago ANTES da quinzena acontecer. Quando alguém falta num dia que já
// foi pago, o dinheiro já saiu — o acerto só pode entrar no PRÓXIMO vale. Esta
// tabela é o que impede o desconto de acontecer duas vezes: a chave única
// (funcionário, dia) é a garantia, no banco, de que cada falta é cobrada uma
// vez só, mesmo que a folha seja reprocessada.
//
// Apagar o lançamento de VT apaga estas linhas junto (ver a rota de exclusão):
// o desconto volta a ficar pendente e entra no vale seguinte.
// ─────────────────────────────────────────────────────────────────────────
model VtFaltaDeduction {
  id            String      @id @default(cuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// O dia da ausência.
  date          DateTime    @db.Date
  /// FALTA ou ATESTADO — os dois recuperam o vale, mas quem confere precisa
  /// saber de qual se trata sem ter de voltar na escala.
  dayType       ScheduleDayType @default(FALTA)
  /// Quanto aquele dia teria custado — o valor efetivamente abatido.
  amount        Decimal     @db.Decimal(12, 2)
  /// O lançamento de VT em que o abatimento entrou.
  payrollItemId String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([employeeId, date])
  @@index([payrollItemId])
}

// Uma perna do trajeto: "na ida, o segundo embarque é metrô". O custo do dia
// é a soma das pernas de IDA + as de VOLTA, cada uma zerando sozinha nos dias
// em que a tarifa dela é gratuita.
model EmployeeVtLeg {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  direction   VtDirection
  sortOrder   Int         @default(0)
  fareId      String
  fare        VtFare      @relation(fields: [fareId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([fareId])
}

model Employee {
  id                String             @id @default(cuid())
  // Pessoal
  firstName         String
  lastName          String
  displayName       String?            // "Como quero ser chamado" — nome exibido na escala
  cpf               String             @unique
  rg                String?
  pis               String?
  birthDate         DateTime?
  gender            EmployeeGender     @default(NAO_INFORMADO)
  phone             String?
  email             String?
  // Endereço
  zipCode           String?
  address           String?
  addressNumber     String?
  addressComplement String?
  neighborhood      String?
  city              String?
  state             String?
  // Bancário
  bankName          String?
  bankAgency        String?
  bankAccount       String?
  bankAccountDigit  String?
  bankAccountType   BankAccountType    @default(CONTA_CORRENTE)
  pixKeyType        String?
  pixKey            String?
  // Trabalho
  sector            String?
  subgroup          String?
  position          String?
  baseSalary        Decimal?           @db.Decimal(12, 2)
  shiftStart        String?
  shiftEnd          String?
  modality          EmployeeModality   @default(CLT)
  scheduleRegime    WorkScheduleRegime @default(SEIS_POR_UM)
  includeInSchedule Boolean            @default(true)
  admissionDate     DateTime?
  // Data de registro na carteira (vem do extrato da contabilidade). Pode ser depois do
  // início real (admissionDate): quem começa sem registro, em teste ou recebendo seguro.
  // Só informativo: gorjeta, VT e escala contam pelo admissionDate.
  admissaoCarteira  DateTime?          @db.Date
  // Vale-transporte. TRANSPORTE_PUBLICO calcula pelas pernas (vtLegs) × escala;
  // BILHETE_MENSAL usa uma tarifa de base MENSAL; AUXILIO_COMBUSTIVEL usa o valor fixo.
  vtType            VtType             @default(TRANSPORTE_PUBLICO)
  vtPeriodicity     VtPeriodicity      @default(QUINZENAL)
  vtFixedAmount     Decimal?           @db.Decimal(12, 2)
  vtLegs            EmployeeVtLeg[]
  vtFaltaDeductions VtFaltaDeduction[]
  vtMonthlyFareId   String?
  vtMonthlyFare     VtFare?            @relation("EmployeeMonthlyFare", fields: [vtMonthlyFareId], references: [id])
  // Desligamento
  terminationDate   DateTime?
  terminationReason String?
  isActive          Boolean            @default(true)
  notes             String?
  holidayCompBalance Int               @default(0)
  scheduleDays      EmployeeScheduleDay[]
  payrollItems      PayrollItem[]
  // Gorjeta (comissão) — Fase A. companyId serve ao agrupamento da exportação.
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])
  participaGorjeta  Boolean            @default(false)
  // Entra na gorjeta em: quem é contratado começa em teste; se fica, o dono decide quando
  // entra no rateio. Vazio = ainda não entrou (em teste ou fora). Sem registro em teste
  // recebe só o salário dos dias (desde a admissão); CLT em teste fica fora do rateio.
  inicioGorjeta     DateTime?          @db.Date
  tipoGorjeta       TipParticipantKind @default(PONTOS)
  cotaFixaGorjeta   Decimal?           @db.Decimal(14, 2)
  // Ponto extra (±) somado aos pontos da função, sempre com justificativa.
  pontosExtra       Decimal?           @db.Decimal(6, 2)
  pontosExtraMotivo String?
  // Salário combinado (acima do registrado): na folha de líquidos vale
  // (salário combinado − adiantamento salarial do extrato) + gorjeta líquida.
  salarioCombinado       Decimal?        @db.Decimal(12, 2)
  salarioCombinadoMotivo String?
  // Teto do IR para a gorjeta informada (CLT): o envio à contabilidade leva
  // teto − salário registrado; a pessoa continua recebendo a gorjeta dos pontos.
  tetoIrGorjeta          Decimal?        @db.Decimal(12, 2)
  // Recebe adiantamento salarial no dia do adiantamento (PayrollSettings). Sem
  // registro: a lista de pagamento desconta o que já foi pago. CLT: só informativo.
  recebeAdiantamento     Boolean         @default(false)
  // Sem registro que recebe por quinzena: metade do salário base no dia 15 (1ª quinzena)
  // e o acerto no dia 30 pela lista de pagamento, que desconta a 1ª quinzena. O cadastro
  // recusa as duas formas juntas (quinzena e adiantamento).
  pagamentoQuinzenal     Boolean         @default(false)
  tipFunctionId     String?
  tipFunction       TipFunction?       @relation(fields: [tipFunctionId], references: [id])
  tipParticipations TipParticipant[]
  tipHistory        EmployeeTipHistory[]
  historicoCadastro EmployeeHistorico[]
  tipReserveMovements TipReserveMovement[]
  // Extras por diária: as que a pessoa trabalhou e as que cobriram a ausência dela.
  extraShifts        ExtraShift[]        @relation("ExtraShiftEmployee")
  extraShiftsCovered ExtraShift[]        @relation("ExtraShiftCovered")
  extraPayments      ExtraPayment[]
  rhExtractPessoas  RhExtractPessoa[]
  // Ficha de registro de empregado (contabilidade): documentos e contrato em carteira.
  // Só consulta — nenhum cálculo lê estes campos. Jornada é a do contrato; o turno real
  // da escala continua em shiftStart/shiftEnd.
  // Nome como está na carteira/ficha ("FULANO DE TAL DOS SANTOS"); Nome + Sobrenome
  // seguem como o restaurante chama a pessoa e podem ser mais curtos.
  nomeCompleto      String?
  registroNumero    String?
  matriculaEsocial  String?
  nomeMae           String?
  nomePai           String?
  estadoCivil       String?
  nacionalidade     String?
  naturalidade      String?
  racaCor           String?
  escolaridade      String?
  possuiDeficiencia Boolean?
  rgDataEmissao     DateTime?          @db.Date
  rgOrgaoEmissor    String?
  rgUf              String?
  tituloEleitor     String?
  tituloZona        String?
  tituloSecao       String?
  ctpsNumero        String?
  ctpsSerie         String?
  ctpsUf            String?
  ctpsDataEmissao   DateTime?          @db.Date
  cbo               String?
  jornadaInicio     String?
  jornadaFim        String?
  intervaloInicio   String?
  intervaloFim      String?
  fgtsDataOpcao     DateTime?          @db.Date
  nomeConjuge       String?
  dependentes       EmployeeDependente[]
  fichasCadastrais  FichaCadastral[]
  feriasRegistradas EmployeeFerias[]
  anotacoesCarteira EmployeeAnotacaoCarteira[]
  // Auditoria / soft delete
  createdById       String
  updatedById       String?
  deletedAt         DateTime?
  deletedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([cpf])
  @@index([isActive])
  @@index([sector])
  @@index([lastName, firstName])
  @@index([terminationDate])
  @@index([deletedAt])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────
// Escala mensal (Fase 2) — marca as FOLGAS por funcionário por dia (o "x" da
// planilha). Ausência de registro = dia trabalhado. Domingos e feriados são
// derivados no backend (não persistidos). Base para a contagem de dias do VT.
// ─────────────────────────────────────────────────────────────────────────

enum ScheduleDayType {
  FOLGA
  /// Folga tirada contra o saldo de feriado trabalhado — debita esse saldo.
  FOLGA_FERIADO
  /// Folga tirada contra o banco de horas.
  FOLGA_BANCO_HORAS
  TURNO
  EVENTO
  FERIAS
  FALTA
  ATESTADO
  /// Afastamento não remunerado (pedido da pessoa): fora da escala, sem salário nem VT;
  /// na gorjeta segue a regra descontaAfastamento. O motivo fica em notes.
  AFASTAMENTO
}

model EmployeeScheduleDay {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  date        DateTime        @db.Date
  type        ScheduleDayType @default(FOLGA)
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

// Evento por data (do dia inteiro, como domingo/feriado) — Pequeno/Médio/Grande.
// Marcado clicando no cabeçalho da data na escala.
enum EventSize {
  PEQUENO
  MEDIO
  GRANDE
}

model ScheduleDayEvent {
  id        String    @id @default(cuid())
  date      DateTime  @unique @db.Date
  size      EventSize
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Folha de Pagamento — Fase 3
// PayrollSettings: tarifas de transporte (configuráveis) + % de adiantamento
// e dias de vencimento. Linha única (id = "singleton").
// PayrollItem: ledger de VT / adiantamento / salário por funcionário/mês
// (mesmo padrão do TaxPayment: dueDate/status/pay/reverse/soft-delete +
// dreCategoryId). Alimenta DRE + Contas a Pagar na Fase 4.
// ─────────────────────────────────────────────────────────────────────────

model PayrollSettings {
  id             String   @id @default("singleton")
  // Dia em que a 2ª quinzena começa. 16 => 1ª quinzena = 01 a 15, 2ª = 16 ao fim.
  // O VT vence sempre na VÉSPERA do início do período (a 1ª quinzena, portanto,
  // vence no último dia do mês ANTERIOR): é assim que o pagamento acontece na
  // prática — 31/08 paga 01→15/09, 15/09 paga 16→30/09.
  vtSecondPeriodStartDay Int @default(16)
  /// A folga precisa cair em DOMINGO pelo menos uma vez a cada N semanas.
  /// Mulher: 2 (CLT art. 386 — escala quinzenal, um domingo sim outro não).
  /// Demais: 3 (Lei 10.101/2000 art. 6º p.único, aplicada a bares e restaurantes).
  ///
  /// Fica em configuração e não no código porque quem define isso na prática é
  /// a convenção coletiva da categoria, que muda todo ano. Número enterrado em
  /// código vira regra errada no dia seguinte a uma negociação sindical.
  dsrDomingoMulherSemanas Int @default(2)
  dsrDomingoGeralSemanas  Int @default(3)
  advancePercent Decimal  @default(40) @db.Decimal(5, 2)
  advanceDueDay  Int      @default(20)
  salaryDueDay   Int      @default(5)
  /// Extras: valor único da diária e da meia diária (decisão do Eli, 29/09/2026).
  /// Cada lançamento guarda o valor do dia; mudar aqui não reescreve o passado.
  diariaValor     Decimal @default(100) @db.Decimal(12, 2)
  meiaDiariaValor Decimal @default(50) @db.Decimal(12, 2)
  /// Extras: limites do aviso de habitualidade de pessoa de fora (risco de vínculo).
  /// Só avisam; ficam aqui porque são critério de gestão, não regra fixa.
  extraHabitualSemana    Int @default(3)
  extraHabitual30Dias    Int @default(8)
  extraHabitualSemanas   Int @default(4)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Rastreabilidade do retorno do RH: cada Extrato Mensal importado (arquivo + dados lidos).
model RhExtract {
  id              String   @id @default(cuid())
  competenceYear  Int
  competenceMonth Int
  empresa         String
  cnpj            String?
  companyId       String?
  totalLiquido    Decimal  @db.Decimal(14, 2)
  headcount       Int
  fileName        String
  storagePath     String?
  sha256          String?
  data            Json     // funcionários lidos (nome, cpf, líquido, gorjeta)
  // "MENSAL" (folha do mês) ou "ADIANTAMENTO". Registros anteriores a esta coluna ficaram MENSAL.
  calculo         String   @default("MENSAL")
  // O PDF inteiro. O disco do Render é apagado a cada deploy: o banco é o armazenamento
  // permanente; storagePath fica só como histórico.
  arquivo         Bytes?
  texto           String?  // texto completo extraído do PDF
  emissao         DateTime? @db.Date
  totalProventos  Decimal? @db.Decimal(14, 2)
  totalDescontos  Decimal? @db.Decimal(14, 2)
  importedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt
  pessoas         RhExtractPessoa[]

  @@index([competenceYear, competenceMonth])
  @@index([companyId])
  // Índice comum, não unique: produção pode já ter o mesmo arquivo importado duas vezes.
  // O dedupe por sha256 é feito na importação.
  @@index([sha256])
}

// Uma pessoa do extrato (cabeçalho e rodapé do holerite). Sem CPF: o vínculo é o employeeId.
model RhExtractPessoa {
  id              String    @id @default(cuid())
  rhExtractId     String
  rhExtract       RhExtract @relation(fields: [rhExtractId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  matricula       String
  nome            String
  situacao        String?
  vinculo         String?
  horasMes        Decimal?  @db.Decimal(8, 2)
  cargoCodigo     String?
  cargo           String?
  cbo             String?
  salarioBase     Decimal?  @db.Decimal(12, 2)
  admissao        DateTime? @db.Date
  demissao        DateTime? @db.Date
  demissaoMotivo  String?
  proventos       Decimal   @db.Decimal(12, 2)
  descontos       Decimal   @db.Decimal(12, 2)
  liquido         Decimal   @db.Decimal(12, 2)
  baseInss        Decimal?  @db.Decimal(12, 2)
  baseFgts        Decimal?  @db.Decimal(12, 2)
  baseIrrf        Decimal?  @db.Decimal(12, 2)
  valorFgts       Decimal?  @db.Decimal(12, 2)
  liquidoRescisao Decimal?  @db.Decimal(12, 2)
  // Rubricas P somam os Proventos e D os Descontos. Falso = leitura a conferir no PDF.
  conferido       Boolean   @default(false)
  texto           String    // bloco bruto da pessoa, sem o CPF
  rubricas        RhExtractRubrica[]

  @@index([rhExtractId])
  @@index([employeeId])
}

model RhExtractRubrica {
  id         String          @id @default(cuid())
  pessoaId   String
  pessoa     RhExtractPessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  codigo     String
  descricao  String
  tipo       String          // "P" provento | "D" desconto
  referencia Decimal?        @db.Decimal(12, 2)
  valor      Decimal         @db.Decimal(12, 2)

  @@index([pessoaId])
  @@index([codigo])
}

enum PayrollItemType {
  ADIANTAMENTO
  SALARIO
  VALE_TRANSPORTE
  RESCISAO
  FERIAS
}

enum PayrollItemStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

model PayrollItem {
  id              String            @id @default(cuid())
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id])
  type            PayrollItemType
  competenceYear  Int
  competenceMonth Int
  periodLabel     String
  periodStart     DateTime?         @db.Date
  periodEnd       DateTime?         @db.Date
  dueDate         DateTime
  amount          Decimal           @db.Decimal(12, 2)
  workedDays      Int?
  freeDays        Int?
  // Resíduo do modelo antigo de VT ("dia de sobra" adiantado + crédito na quinzena
  // seguinte), aposentado em 09/2026 — a quinzena agora é calculada exata. As colunas
  // ficam porque os lançamentos de julho/2026 as usaram e precisam continuar auditáveis;
  // nada novo escreve aqui.
  bufferAmount    Decimal?          @db.Decimal(12, 2)
  creditApplied   Decimal?          @db.Decimal(12, 2)
  details         Json?
  paymentDate     DateTime?
  paidAmount      Decimal?          @db.Decimal(12, 2)
  vtFaltaDeductions     VtFaltaDeduction[]
  paidPaymentMethodId   String?
  paidPaymentMethodName String?
  paidByCompanyId       String?
  companyBankAccountId  String?
  differenceReason      String?
  paymentNotes          String?
  status          PayrollItemStatus @default(PENDING)
  dreCategoryId   String?
  dreCategory     DRECategory?      @relation(fields: [dreCategoryId], references: [id])
  notes           String?
  source          String            @default("GENERATED")
  // Lote de pagamento da folha: o SALARIO entra num título por empresa no Contas a Pagar.
  // Enquanto o lote existe (aberto ou pago) o item não aparece solto nem é baixado sozinho.
  // folhaLoteOrigemId: o lote da empresa de onde a pessoa foi retirada (para devolver).
  folhaLoteId       String?
  folhaLote         FolhaLote?        @relation(fields: [folhaLoteId], references: [id], onDelete: SetNull)
  folhaLoteOrigemId String?
  createdById     String
  updatedById     String?
  deletedAt       DateTime?
  deletedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([employeeId, type, competenceYear, competenceMonth, periodLabel])
  @@index([folhaLoteId])
  @@index([competenceYear, competenceMonth])
  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
  @@index([dreCategoryId])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// FASE A — Folha da Gorjeta (Comissão)
// ═══════════════════════════════════════════════════════════════════════════

enum TipPeriodStatus {
  OPEN
  CLOSED
}

enum TipParticipantKind {
  FIXO   // recebe cota fixa da gorjeta (sai do pool antes do rateio)
  PONTOS // recebe pela pontuação
}

enum TipValeType {
  REFEICAO
  VALE_CONSUMO
  RETIRADA_CAIXA
  ADIANTAMENTO
  OUTRO
  // Único tipo que SOMA ao valor a receber (ajuste a favor do funcionário).
  CREDITO
}

// Função/nível e seus pontos-base no rateio (aba "Regras e Pontos" da planilha).
model TipFunction {
  id        String     @id
  name      String     @unique
  points    Decimal    @db.Decimal(6, 2)
  minPoints Decimal?   @db.Decimal(6, 2)
  maxPoints Decimal?   @db.Decimal(6, 2)
  group     String?
  notes     String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  employees Employee[]
  history   TipFunctionHistory[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Histórico da função e dos pontos de cada funcionário na gorjeta. Uma linha por
// mudança (ou por mudança na tabela de funções que altere a base dele), com a
// data a partir da qual vale. Base dos relatórios de promoção e evolução.
model EmployeeTipHistory {
  id               String   @id
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  validFrom        DateTime @db.Date
  participaGorjeta Boolean
  tipFunctionId    String?
  functionName     String?
  functionPoints   Decimal? @db.Decimal(6, 2)
  pontosPadrao     Decimal? @db.Decimal(6, 2) // legado: pontos personalizados (antes do ponto extra)
  pontosExtra      Decimal? @db.Decimal(6, 2)
  pontosExtraMotivo String?
  basePoints       Decimal? @db.Decimal(6, 2)
  reason           String?
  changedById      String
  createdAt        DateTime @default(now())

  @@index([employeeId, validFrom])
  @@index([validFrom])
}

// Histórico do cadastro: salário, vínculo, empresa, cargo etc. com a data a partir da
// qual valem. Cálculo de mês passado usa o valor VIGENTE naquele mês, não o atual.
// Valores em texto ("2200.00", "NAO_CLT", "true"); nunca guarda CPF.
model EmployeeHistorico {
  id            String   @id
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  campo         String   // baseSalary | salarioCombinado | tetoIrGorjeta | modality | companyId | position | recebeAdiantamento | pagamentoQuinzenal
  valorAnterior String?
  valorNovo     String?
  vigenteDesde  DateTime @db.Date
  motivo        String?
  origem        String   // CADASTRO | EQUIPE_GORJETA | CONFERENCIA_GORJETA | IMPORTADOR_PLANILHA | BACKFILL
  // Backfill: id do AuditLog de onde a linha veio (rodar de novo não duplica).
  origemRef     String?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())

  @@unique([origemRef, campo])
  @@index([employeeId, campo, vigenteDesde])
}

// Ficha de registro de empregado: dependentes (os "beneficiários" da ficha), férias e a
// carteira (admissão, aumentos, mudança de cargo). Só consulta. origem FICHA_REGISTRO = veio
// da importação, que apaga e regrava as dela a cada importação (a ficha é cumulativa).
model EmployeeDependente {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nome           String
  parentesco     String?
  dataNascimento DateTime? @db.Date
  cpf            String?
  origem         String    @default("CADASTRO") // CADASTRO | FICHA_REGISTRO | FICHA_CADASTRAL
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
}

model EmployeeFerias {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  aquisitivoInicio DateTime  @db.Date
  aquisitivoFim    DateTime  @db.Date
  gozoInicio       DateTime? @db.Date
  gozoFim          DateTime? @db.Date
  abonoInicio      DateTime? @db.Date
  abonoFim         DateTime? @db.Date
  origem           String    @default("FICHA_REGISTRO")
  createdAt        DateTime  @default(now())

  @@index([employeeId, aquisitivoInicio])
}

// Anotações da carteira. Não é o histórico do cadastro (EmployeeHistorico): aquele alimenta
// o cálculo de mês passado; este é o registro da contabilidade, para consulta.
model EmployeeAnotacaoCarteira {
  id                    String   @id @default(cuid())
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tipo                  String   // ADMISSAO | SALARIO | CARGO
  data                  DateTime @db.Date
  salario               Decimal? @db.Decimal(12, 2)
  retroativoCompetencia String?  // "MM/AAAA"
  cargoAnterior         String?
  cboAnterior           String?
  cargo                 String?
  cbo                   String?
  origem                String   @default("FICHA_REGISTRO")
  createdAt             DateTime @default(now())

  @@index([employeeId, data])
}

// Mudanças na tabela de funções (nome, pontos, faixa).
model TipFunctionHistory {
  id            String      @id
  tipFunctionId String
  tipFunction   TipFunction @relation(fields: [tipFunctionId], references: [id])
  name          String
  pointsBefore  Decimal?    @db.Decimal(6, 2)
  pointsAfter   Decimal     @db.Decimal(6, 2)
  minPoints     Decimal?    @db.Decimal(6, 2)
  maxPoints     Decimal?    @db.Decimal(6, 2)
  changedById   String
  createdAt     DateTime    @default(now())

  @@index([tipFunctionId, createdAt])
}

// Fundo de reserva da gorjeta: extrato de entradas (reserva e saldo de cada
// fechamento, ajustes) e saídas (distribuição a funcionários). Saldo = soma.
model TipReserveMovement {
  id          String     @id
  date        DateTime   @db.Date
  // FECHAMENTO_RESERVA | FECHAMENTO_SALDO | DISTRIBUICAO | AJUSTE
  type        String
  amount      Decimal    @db.Decimal(14, 2)
  periodId    String?
  period      TipPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?  @relation(fields: [employeeId], references: [id])
  valeId      String?    @unique
  vale        TipVale?   @relation(fields: [valeId], references: [id], onDelete: Cascade)
  notes       String?
  createdById String
  createdAt   DateTime   @default(now())

  @@index([date])
  @@index([periodId])
}

// Registro permanente de cada fechamento da gorjeta (retrato completo). Um
// fechamento por versão: reabrir marca a versão como reaberta (com motivo) e o
// próximo fechamento cria a versão seguinte. O banco impede apagar e editar o
// conteúdo (trigger na migration); só os campos de reabertura são gravados depois.
model TipPeriodClosing {
  id             String    @id
  periodId       String
  period         TipPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  code           String    @unique // GOR-AAAA-NNNN/vN
  version        Int
  competenceYear  Int
  competenceMonth Int
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  closedAt       DateTime
  closedById     String
  closedByName   String
  params         Json
  totals         Json
  participants   Json
  reserve        Json
  // SHA-256 do conteúdo (params + totais + pessoas + fundo), para provar integridade.
  payloadHash    String
  reopenedAt     DateTime?
  reopenedById   String?
  reopenedByName String?
  reopenReason   String?

  @@unique([periodId, version])
  @@index([competenceYear, competenceMonth])
}

// Competência da gorjeta: 26 do mês anterior a 25 do mês da competência.
// Pool único (não separa por empresa); a empresa importa só na exportação.
model TipPeriod {
  id               String           @id @default(cuid())
  // Código da apuração, gerado automaticamente: GOR-AAAA-NNNN.
  code             String           @unique
  competenceYear   Int
  competenceMonth  Int
  periodStart      DateTime         @db.Date
  periodEnd        DateTime         @db.Date
  label            String
  grossPool        Decimal          @default(0) @db.Decimal(14, 2)
  poolSource       String           @default("REVENUE") // REVENUE (puxado) | MANUAL (editado)
  // Serviço arrecadado = o que veio do faturamento + ajuste manual (serviço que
  // não passa pelo sistema). grossPool guarda a soma.
  servicoFaturamento  Decimal       @default(0) @db.Decimal(14, 2)
  ajusteServico       Decimal       @default(0) @db.Decimal(14, 2)
  ajusteServicoMotivo String?
  deductionPercent Decimal          @default(20) @db.Decimal(5, 2)
  netPool          Decimal          @default(0) @db.Decimal(14, 2)
  pointsTotal      Int              @default(100) // total de pontos do rateio (denominador). Editável por competência.
  pointValue       Decimal          @default(0) @db.Decimal(14, 6)
  // Presença: dias padrão de trabalho no período e quais ocorrências reduzem o rateio.
  diasPadrao       Int              @default(26)
  descontaFalta    Boolean          @default(true)
  descontaAtestado Boolean          @default(true)
  descontaFerias   Boolean          @default(true)
  descontaOutros   Boolean          @default(false)
  // Afastamento não remunerado desconta na gorjeta (o salário e o VT descontam sempre).
  descontaAfastamento Boolean       @default(true)
  // Admitido no meio do período recebe proporcional aos dias.
  proporcionalEntrada Boolean       @default(true)
  // Parte de quem saiu depois da saída: false = sobe o ponto de quem fica;
  // true = o ponto do mês não desconta as rescisões e a sobra vai para o livre.
  sobraRescisaoParaSaldo Boolean    @default(false)
  // Parte do líquido que ficou sem distribuir no fechamento.
  saldoRetido      Decimal          @default(0) @db.Decimal(14, 2)
  // Pontos que vão para o fundo de reserva da gorjeta (valor = pontos × valor do ponto).
  reservaPontos    Decimal          @default(0) @db.Decimal(8, 2)
  reserveMovements TipReserveMovement[]
  closings         TipPeriodClosing[]
  extratos         TipExtrato[]
  aceites          TipConferenciaAceite[]
  etapas           TipPeriodEtapa[]
  status           TipPeriodStatus  @default(OPEN)
  closedAt         DateTime?
  participants     TipParticipant[]
  createdById      String
  updatedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([competenceYear, competenceMonth])
  @@index([status])
}

model TipParticipant {
  id            String             @id @default(cuid())
  periodId      String
  period        TipPeriod          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  kind          TipParticipantKind @default(PONTOS)
  // Pontos da função (ou personalizados) trazidos do cadastro — não se edita aqui.
  basePoints       Decimal?        @db.Decimal(8, 2)
  // Função do período, guardada para os relatórios não mudarem se o cadastro mudar.
  functionName     String?
  // Acréscimo (+) ou desconto (−) do mês sobre os pontos-base.
  pointsAdjustment Decimal         @default(0) @db.Decimal(8, 2)
  // Pontos finais (base × presença + ajuste), gravados no fechamento.
  points        Decimal?           @db.Decimal(8, 2)
  fixedAmount   Decimal?           @db.Decimal(14, 2)
  // Ocorrências do período. null = usar o que está na Escala.
  atestados            Int?
  ferias               Int?
  outrosDias           Int?
  diasPrevistosOverride Int?
  // Decisão de quem fecha para esta pessoa (null = regra do período).
  descontaFalta        Boolean?
  descontaAtestado     Boolean?
  descontaFerias       Boolean?
  descontaOutros       Boolean?
  proporcionalEntrada  Boolean?
  descontaAfastamento  Boolean?
  // Rescisão: serviço bruto até o desligamento (null = puxar do faturamento)
  // e valor já quitado/congelado, que prevalece sobre o cálculo.
  rescisaoServicoBruto Decimal?    @db.Decimal(14, 2)
  rescisaoValorFixo    Decimal?    @db.Decimal(14, 2)
  // Recibo da rescisão lido do TRCT (gorjeta paga, datas, hash do arquivo).
  rescisaoRecibo       Json?
  // Gorjeta real digitada no lugar da calculada (quem está no mês). Os outros não mudam;
  // a diferença vai para o livre para distribuir. Motivo, quem e quando ficam aqui.
  gorjetaReal          Decimal?    @db.Decimal(14, 2)
  gorjetaRealMotivo    String?
  gorjetaRealPor       String?
  gorjetaRealEm        DateTime?
  // Sem registro: dias de salário (null = calcular) e valores do fechamento.
  diasSalarioOverride  Int?
  salarioProporcional  Decimal     @default(0) @db.Decimal(14, 2)
  totalAPagar          Decimal     @default(0) @db.Decimal(14, 2)
  rateioAmount  Decimal            @default(0) @db.Decimal(14, 2)
  valesTotal    Decimal            @default(0) @db.Decimal(14, 2)
  netCommission Decimal            @default(0) @db.Decimal(14, 2)
  // Sem registro que não participa da gorjeta: está no período só para receber o salário
  // (e ter vales) na lista de pagamento. Não entra no rateio: pontos e gorjeta zero.
  foraDaGorjeta Boolean            @default(false)
  // Dados informados para o RH/contabilidade (por competência) — vão no PDF de envio.
  horaExtra        String?         // texto livre (ex.: "1,05")
  adicionalNoturno String?         // texto livre (ex.: "2,10")
  faltas           Int?            // número de faltas no período
  justificada      Boolean         @default(false)
  vales         TipVale[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

// Vale descontado por dentro da comissão, antes do RH. Não vai ao holerite.
model TipVale {
  id            String         @id @default(cuid())
  participantId String
  participant   TipParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  type          TipValeType    @default(OUTRO)
  amount        Decimal        @db.Decimal(14, 2)
  date          DateTime?      @db.Date
  notes         String?
  createdById   String
  createdByName String?
  createdAt     DateTime       @default(now())
  updatedById   String?
  updatedAt     DateTime?
  // Cancelar não apaga: o vale fica no histórico e nos relatórios, só deixa de descontar.
  canceledAt     DateTime?
  canceledById   String?
  canceledByName String?
  cancelReason   String?
  // Número impresso no recibo (VALE-AAAA-NNNNN) e o último recibo emitido.
  codigo            String?   @unique
  reciboEmpresaId   String?
  reciboImpressoEm  DateTime?
  reciboImpressoPor String?
  reciboImpressoes  Int       @default(0)
  reserveMovement TipReserveMovement?

  @@index([participantId])
  @@index([canceledAt])
}

/// Ciclo operacional de estoque: o intervalo real entre duas contagens de
/// fechamento. O restaurante nao fecha o CMV por competencia estrita — o ciclo
/// termina no dia em que se conta, e esse dia cai no mes seguinte sempre que o
/// ultimo dia do mes esta ocupado (agosto/2026 fechou em 02/09, maio em 01/06).
///
/// Ate aqui o ciclo era implicito, um par de campos nas contagens. Declarado
/// assim, com comeco e fim, da para somar "as compras do ciclo" e nao so as da
/// competencia — que e o que permite as duas visoes nos relatorios.
///
/// Os ciclos nao se sobrepoem e nao deixam buraco: cada um comeca no dia
/// seguinte ao fim do anterior.
model StockCycle {
  id                String   @id
  competenceYear    Int
  competenceMonth   Int
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  /// ABERTO enquanto nao ha inventario final aprovado; FECHADO depois.
  status            String   @default("ABERTO")
  /// O InventorySnapshot final que encerra o ciclo, quando ja existe.
  closingSnapshotId String?
  /// SISTEMA para os derivados do historico; MANUAL quando alguem ajusta.
  source            String   @default("SISTEMA")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([competenceYear, competenceMonth])
  @@index([startDate, endDate])
  @@index([status])
  @@index([closingSnapshotId])
}

// Extrato mensal de uma empresa, devolvido pela contabilidade, lido para conferir
// a gorjeta e montar a folha de líquidos. Um por empresa (CNPJ) e período.
model TipExtrato {
  id              String    @id
  periodId        String
  period          TipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  empresa         String
  cnpj            String
  competenceYear  Int
  competenceMonth Int
  arquivo         String
  hash            String
  // [{ employeeId, nome, liquido, gorjeta, adiantamento, situacao }] — sem CPF.
  linhas          Json
  importadoEm     DateTime  @default(now())
  importadoPorId  String
  importadoPor    String

  @@unique([periodId, cnpj])
}

// Divergência entre apuração e extrato aceita por quem confere, com justificativa.
model TipConferenciaAceite {
  id            String    @id
  periodId      String
  period        TipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeKey   String    // employeeId, ou "extrato:<nome>" quem não está no cadastro
  justificativa String
  porId         String
  por           String
  em            DateTime  @default(now())

  @@unique([periodId, employeeKey])
}

// Etapas do mês depois da apuração: enviado à contabilidade, OK dado, folha paga.
// Só acrescenta: marcar e desmarcar ficam no histórico.
model TipPeriodEtapa {
  id       String    @id
  periodId String
  period   TipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  etapa    String    // ENVIADO_CONTABILIDADE | OK_CONTABILIDADE | FOLHA_PAGA
  acao     String    // MARCOU | DESMARCOU
  obs      String?
  porId    String
  por      String
  em       DateTime  @default(now())

  @@index([periodId, em])
}

// Lote de pagamento da folha: um título por empresa (CNPJ), um para os sem registro e
// uma "Folha à parte" para quem foi retirado — agrupa os SALARIO da competência no Contas a
// Pagar. O valor é sempre a soma viva dos membros; a baixa do lote baixa cada membro.
// Um só lote ABERTO por competência e grupo (índice parcial na migration).
model FolhaLote {
  id                    String        @id
  competenceYear        Int
  competenceMonth       Int
  grupo                 String        // CNPJ (só dígitos) | SEM_REGISTRO | A_PARTE
  rotulo                String
  dueDate               DateTime
  status                String        @default("ABERTO") // ABERTO | PAGO | CANCELADO
  paymentDate           DateTime?
  paidPaymentMethodId   String?
  paidPaymentMethodName String?
  paidByCompanyId       String?
  companyBankAccountId  String?
  paymentNotes          String?
  cancelReason          String?
  canceledAt            DateTime?
  createdById           String
  createdByName         String
  updatedById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  membros               PayrollItem[]

  @@index([competenceYear, competenceMonth])
  @@index([status])
  @@index([dueDate])
}

// Descrições prontas para os vales (por tipo ou para todos). Desativar não apaga.
model TipValeDescricao {
  id          String       @id
  texto       String
  tipo        TipValeType?
  ativo       Boolean      @default(true)
  ordem       Int          @default(0)
  createdById String
  createdAt   DateTime     @default(now())

  @@unique([texto, tipo])
}

// ─────────────────────────────────────────────────────────────────────────
// Extras por diária. Quem já é da casa (CLT ou sem registro) vem do cadastro
// de Funcionários; quem vem de fora, por indicação, ganha um cadastro leve aqui.
// Cada diária aponta para exatamente UM dos dois (CHECK no banco).
enum ExtraShiftDuration {
  INTEIRA
  MEIA
}

enum ExtraShiftReason {
  COBERTURA_FALTA
  COBERTURA_FOLGA
  COBERTURA_FERIAS
  EVENTO
  MOVIMENTO
  OUTRO
}

enum ExtraShiftStatus {
  PREVISTA
  REALIZADA
  NAO_COMPARECEU
  CANCELADA
}

model ExtraWorker {
  id          String       @id @default(cuid())
  fullName    String
  displayName String?
  // Opcional: nem todo indicado passa CPF na primeira vez. Único entre os não
  // excluídos — índice parcial só na migration (o Prisma não o representa).
  cpf         String?
  phone       String?
  pixKeyType  String?
  pixKey      String?
  referredBy  String?
  notes       String?
  isActive    Boolean      @default(true)
  shifts      ExtraShift[]
  payments    ExtraPayment[]
  createdById String
  updatedById String?
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([cpf])
  @@index([fullName])
  @@index([deletedAt])
}

model ExtraShift {
  id                String             @id @default(cuid())
  date              DateTime           @db.Date
  employeeId        String?
  employee          Employee?          @relation("ExtraShiftEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  extraWorkerId     String?
  extraWorker       ExtraWorker?       @relation(fields: [extraWorkerId], references: [id], onDelete: Restrict)
  sector            String
  role              String?
  startTime         String?
  endTime           String?
  duration          ExtraShiftDuration @default(INTEIRA)
  reason            ExtraShiftReason
  // Nome do evento do centro de convenções (ex.: "Apraxia"): custo de extras por evento.
  eventName         String?
  coveredEmployeeId String?
  coveredEmployee   Employee?          @relation("ExtraShiftCovered", fields: [coveredEmployeeId], references: [id])
  // Valor da diária no dia do lançamento (padrão da configuração ou ajustado).
  baseAmount        Decimal            @db.Decimal(12, 2)
  // Ajuste do valor padrão exige motivo — fica visível na lista e na auditoria.
  baseAdjustReason  String?
  transportAmount   Decimal            @default(0) @db.Decimal(12, 2)
  bonusAmount       Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal            @db.Decimal(12, 2)
  status            ExtraShiftStatus   @default(REALIZADA)
  notes             String?
  // Pagamento (título no Contas a Pagar) que inclui esta diária. Com pagamento,
  // a diária fica travada: cancelar o pagamento antes de mudar.
  paymentId         String?
  payment           ExtraPayment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdById       String
  updatedById       String?
  deletedAt         DateTime?
  deletedById       String?
  deleteReason      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([date])
  @@index([employeeId])
  @@index([extraWorkerId])
  @@index([paymentId])
  @@index([deletedAt])
}

// Pagamento de extras: agrupa diárias realizadas de UMA pessoa num título do
// Contas a Pagar (uma diária, as do dia ou as da semana — quem paga escolhe).
// O DRE não lê esta tabela: o custo entra pela data de cada diária.
enum ExtraPaymentStatus {
  PENDING
  PAID
  CANCELED
}

model ExtraPayment {
  id                    String             @id @default(cuid())
  // EXT-AAAA-NNNN: aparece no recibo e no Contas a Pagar.
  code                  String             @unique
  employeeId            String?
  employee              Employee?          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  extraWorkerId         String?
  extraWorker           ExtraWorker?       @relation(fields: [extraWorkerId], references: [id], onDelete: Restrict)
  amount                Decimal            @db.Decimal(12, 2)
  dueDate               DateTime           @db.Date
  status                ExtraPaymentStatus @default(PENDING)
  paymentDate           DateTime?
  paidAmount            Decimal?           @db.Decimal(12, 2)
  paidPaymentMethodId   String?
  paidPaymentMethodName String?
  paidByCompanyId       String?
  companyBankAccountId  String?
  differenceReason      String?
  paymentNotes          String?
  notes                 String?
  shifts                ExtraShift[]
  cancelReason          String?
  canceledAt            DateTime?
  canceledById          String?
  createdById           String
  updatedById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([dueDate])
  @@index([status])
  @@index([employeeId])
  @@index([extraWorkerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Ficha cadastral por link: a pessoa preenche os próprios dados e manda as fotos
// dos documentos pelo celular, sem login. Os dados ficam aqui (e não no cadastro)
// até o RH conferir e concluir — ficha pela metade não suja o Employee.
// O link só existe no WhatsApp de quem recebeu: o banco guarda o hash do código.
// ─────────────────────────────────────────────────────────────────────────

enum FichaCadastralTipo {
  /// Pessoa ainda não está no sistema: ao concluir, vira um funcionário novo.
  ADMISSAO
  /// Funcionário existente completando/corrigindo os próprios dados.
  ATUALIZACAO
}

enum FichaCadastralStatus {
  ENVIADA
  PREENCHENDO
  FINALIZADA
  CONCLUIDA
  CANCELADA
}

model FichaCadastral {
  id                String                  @id @default(cuid())
  tipo              FichaCadastralTipo
  status            FichaCadastralStatus    @default(ENVIADA)
  tokenHash         String                  @unique
  expiraEm          DateTime
  /// Como o RH chamou a pessoa ao gerar o link (lista e mensagem do WhatsApp).
  nomeReferencia    String
  /// Atualização: o funcionário desde o início. Admissão: o criado ao concluir.
  employeeId        String?
  employee          Employee?               @relation(fields: [employeeId], references: [id])
  /// O que a pessoa preencheu (campos de ficha-cadastral-campos.ts).
  dados             Json                    @default("{}")
  /// O que o RH completa: empresa, admissão, função, salário, horário, VT.
  dadosEmpresa      Json                    @default("{}")
  /// Data de nascimento errada ao abrir o link: bloqueia por um tempo.
  tentativasErradas Int                     @default(0)
  bloqueadoAte      DateTime?
  motivoDevolucao   String?
  primeiroAcessoEm  DateTime?
  finalizadaEm      DateTime?
  concluidaEm       DateTime?
  canceladaEm       DateTime?
  createdById       String
  concluidaPorId    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  arquivos          FichaCadastralArquivo[]

  @@index([status])
  @@index([employeeId])
}

/// Foto/PDF de documento enviado pelo link. Fica no banco (o disco do Render é
/// apagado a cada deploy) e é guardado como comprovação; ficha cancelada ou vencida é apagada em 90 dias (ficha-cadastral-expurgo.ts).
model FichaCadastralArquivo {
  id           String         @id @default(cuid())
  fichaId      String
  ficha        FichaCadastral @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  tipo         String // RG, CPF, CTPS, COMPROVANTE_ENDERECO, TITULO, CERTIDAO, ESCOLARIDADE, OUTRO
  nomeOriginal String
  mimeType     String
  tamanho      Int
  sha256       String
  conteudo     Bytes
  createdAt    DateTime       @default(now())

  @@index([fichaId])
}

// ─────────────────────────────────────────────────────────────────────────
// Painel de Eventos: histórico dos eventos que trazem gente ao restaurante
// (centro de convenções, teatro e grupos com pacote) para decidir a operação
// do dia: modalidade, tamanho do buffet e reservas. Ver docs/painel-eventos.md.
// ─────────────────────────────────────────────────────────────────────────

enum EventOrigin {
  CENTRO_CONVENCOES
  TEATRO
  GRUPO
}

enum EventArea {
  SAUDE
  CORPORATIVO
  TECNOLOGIA
  JURIDICO
  FINANCEIRO
  FEIRA_VAREJO
  EDUCACAO
  ENTRETENIMENTO
  OUTRO
}

enum ServiceMode {
  BUFFET
  BUFFET_EXECUTIVO
  A_LA_CARTE
}

/// O evento que se repete. Junta todas as edições para responder "como foi no ano passado".
model EventSeries {
  id        String         @id @default(cuid())
  name      String
  /// Nome normalizado (sem acento, ano, número da edição). Casa variações do mesmo evento.
  nameKey   String         @unique
  /// Chaves de séries que foram juntadas a esta: a importação reconhece o nome antigo.
  aliasKeys String[]       @default([])
  origin    EventOrigin    @default(CENTRO_CONVENCOES)
  area      EventArea      @default(OUTRO)
  organizer String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  editions  EventEdition[]
}

/// Cada vez que a série acontece.
model EventEdition {
  id                String            @id @default(cuid())
  seriesId          String
  series            EventSeries       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title             String
  startDate         DateTime          @db.Date
  endDate           DateTime          @db.Date
  announcedAudience Int?
  floor             String?
  contact           String?
  /// PLANILHA | CIRCULAR | MANUAL
  source            String            @default("MANUAL")
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  days              EventEditionDay[]

  @@unique([seriesId, startDate])
  @@index([startDate])
}

/// Um dia de uma edição. Só o que é do evento; o que é do restaurante fica em OperationDay.
model EventEditionDay {
  id          String       @id @default(cuid())
  editionId   String
  edition     EventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  startTime   String?
  endTime     String?
  /// O evento serviu almoço lá dentro (lunch box, finger food): tira gente do restaurante.
  lunchInside Boolean?

  @@unique([editionId, date])
  @@index([date])
}

/// Uma linha por data: a decisão e o histórico do restaurante naquele dia.
/// O faturamento nunca fica no evento, então dia com dois eventos não duplica.
model OperationDay {
  id                 String       @id @default(cuid())
  date               DateTime     @unique @db.Date
  serviceMode        ServiceMode?
  buffetPrice        Decimal?     @db.Decimal(10, 2)
  /// Previsão congelada quando a decisão foi salva, para medir o acerto depois.
  forecastLunch      Int?
  forecastSize       EventSize?
  forecastBasis      String?
  /// Antes do PDV entrar no ERP (2024–2025), vindo da planilha. Valores SEM os 10%.
  legacyLunchPeople  Int?
  legacyLunchSales   Decimal?     @db.Decimal(14, 2)
  legacyDinnerPeople Int?
  legacyDinnerSales  Decimal?     @db.Decimal(14, 2)
  notes              String?
  updatedById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

/// Limites da sugestão de buffet e capacidade do salão. Linha única (id = "singleton").
model EventSettings {
  id            String   @id @default("singleton")
  /// Até este número de almoços previstos: buffet Pequeno.
  smallMaxLunch Int      @default(80)
  /// Acima deste número: buffet Grande. Entre os dois: Médio.
  largeMinLunch Int      @default(150)
  /// Lugares do salão no almoço, contando o giro. Vazio enquanto não for informado.
  lunchCapacity Int?
  updatedAt     DateTime @updatedAt
}
