# Exemplo de variáveis para o frontend. Copie para `frontend/.env.local`
# (dev) ou `frontend/.env.production` (build de produção) e preencha.
# Vite exige o prefixo `VITE_` para variáveis expostas ao browser.

# Base URL da API. Em dev normalmente aponta pro backend local.
# Em produção: https://pateo-backend.onrender.com
VITE_API_BASE_URL="http://localhost:3334"
